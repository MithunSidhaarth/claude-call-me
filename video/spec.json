{
  "spec_version": 1,
  "id": "claude_call_me_promo",
  "kind": "explainer",
  "format": "landscape",
  "theme": "theme.json",
  "look": "neon",
  "motion": "lively",
  "backdrop": "grid",
  "transition": "zoom",
  "captions_style": "karaoke",
  "say_captions": true,
  "sfx_density": "rich",
  "punch": true,
  "post": {
    "bloom": 0.7,
    "halation": 0.45,
    "aberration": 3,
    "grain": 0.35,
    "tone": true
  },
  "music": {
    "mood": "upbeat",
    "db": -10
  },
  "voice": {
    "provider": "elevenlabs",
    "voice_id": "TBD",
    "model": "eleven_multilingual_v2",
    "gap": 0.22
  },
  "scenes": [
    {
      "type": "slam",
      "words": [
        "YOUR",
        "PHONE",
        "RINGS."
      ],
      "invert": true,
      "size": 280,
      "hold": 0.4,
      "camera": {
        "zoom": [
          1.0,
          1.15
        ]
      },
      "say": "Your phone rings.",
      "dur": 3.5
    },
    {
      "type": "device",
      "kind": "phone",
      "src": "assets/incoming-call.png",
      "zoom": 1.15,
      "pan": [
        0.5,
        0.25,
        0.5,
        0.55
      ],
      "backdrop": "orbs",
      "gradient": [
        "#2A0608",
        "#07070A"
      ],
      "transition": "zoom",
      "say": "It's Claude. It needs one decision.",
      "dur": 3.5
    },
    {
      "type": "strike",
      "kicker": "STOP",
      "wrong": "Babysit the terminal for hours.",
      "right": "Walk away. Claude calls you.",
      "camera": {
        "zoom": [
          1.0,
          1.08
        ]
      },
      "transition": "wipe",
      "say": "Stop babysitting the terminal. Walk away. Claude calls you.",
      "dur": 3.5
    },
    {
      "type": "flow",
      "title": "When it's stuck",
      "nodes": [
        "Stuck",
        "Calls you",
        "You answer",
        "Back to work"
      ],
      "loop": true,
      "backdrop": "dots",
      "gradient": [
        "#07070A",
        "#2A0608"
      ],
      "camera": {
        "zoom": [
          1.12,
          1.0
        ]
      },
      "say": "When it's stuck, it calls you. You answer. It gets back to work.",
      "dur": 3.5
    },
    {
      "type": "code",
      "title": "LIVE CALL",
      "cps": 60,
      "highlight": [
        2
      ],
      "lines": [
        "agent:  Postgres or SQLite for the cache?",
        "you:    SQLite. Keep it simple.",
        "agent:  SQLite, confirmed. Back to work."
      ],
      "camera": {
        "zoom": [
          1.0,
          1.12
        ],
        "drift": 0.3
      },
      "transition": "push",
      "say": "A real voice agent asks, confirms your answer, and hangs up.",
      "dur": 3.5
    },
    {
      "type": "compare",
      "title": "Your afternoon",
      "left": {
        "title": "Without it",
        "items": [
          "Check the terminal",
          "Claude waits on you",
          "Come back to a question"
        ]
      },
      "right": {
        "title": "With call-me",
        "items": [
          "Phone rings",
          "Answer in a minute",
          "Come back to finished work"
        ]
      },
      "backdrop": "grid",
      "camera": {
        "zoom": [
          1.05,
          1.0
        ]
      },
      "transition": "wipe",
      "say": "Without it, Claude waits on you. With it, you come back to finished work.",
      "dur": 3.5,
      "gradient": [
        "#07070A",
        "#2A0608"
      ]
    },
    {
      "type": "timeline",
      "title": "Every time a task ends",
      "events": [
        {
          "when": "Task done",
          "what": "Update call"
        },
        {
          "when": "You pick",
          "what": "Next step, by voice"
        },
        {
          "when": "Live",
          "what": "Done, calls again"
        }
      ],
      "camera": {
        "drift": 0.3
      },
      "transition": "push",
      "say": "When a task ends, it calls with next steps. You pick one, and it does it, live.",
      "dur": 3.5
    },
    {
      "type": "stat",
      "style": "odometer",
      "title": "EVERY MORNING",
      "value": 9,
      "suffix": " AM",
      "size": 320,
      "when": "nine",
      "source": "install.ps1 -Standup 09:00 (configurable)",
      "backdrop": "orbs",
      "gradient": [
        "#2A0608",
        "#07070A"
      ],
      "camera": {
        "zoom": [
          1.0,
          1.18
        ]
      },
      "transition": "zoom",
      "say": "And every morning at nine, a standup call about yesterday.",
      "dur": 3.5
    },
    {
      "type": "note",
      "invert": true,
      "kicker": "YOUR KEYS STAY YOURS",
      "text": "Keys live in env vars. Never in chat.",
      "small": "Calls run on your own Bolna account.",
      "camera": {
        "zoom": [
          1.1,
          1.0
        ]
      },
      "transition": "wipe",
      "say": "Your keys never touch the chat.",
      "dur": 3.5
    },
    {
      "type": "slam",
      "words": [
        "CALL",
        "ME."
      ],
      "size": 340,
      "hold": 0.38,
      "camera": {
        "zoom": [
          1.0,
          1.25
        ]
      },
      "transition": "cut",
      "say": "Call me.",
      "dur": 3.5
    },
    {
      "type": "endcard",
      "button": "Get it on GitHub",
      "camera": {
        "zoom": [
          1.06,
          1.0
        ]
      },
      "backdrop": "orbs",
      "say": "Claude call me. Free and open source.",
      "dur": 3.5
    }
  ]
}