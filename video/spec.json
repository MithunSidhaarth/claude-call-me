      "transition": "wipe",
      "say": "Stop babysitting the terminal. Walk away. Claude calls you.",
      "dur": 3.5
    },
    {
      "type": "flow",
      "title": "When it's stuck",
      "nodes": [
        "Stuck",
        "Calls you",
        "You answer",
        "Back to work"
      ],
      "loop": true,
      "gradient": [
        "#07070A",
        "#2A0608"
      ],
      "camera": {
        "zoom": [
          1.1,
          1.0
        ]
      },
      "say": "When it's stuck, it calls you. You answer. It gets back to work.",
      "dur": 3.5
    },
    {
      "type": "code",
      "title": "LIVE CALL",
      "cps": 55,
      "highlight": [
        2
      ],
      "lines": [
        "agent:  Postgres or SQLite for the cache?",
        "you:    SQLite. Keep it simple.",
        "agent:  SQLite, confirmed. Back to work."
      ],
      "camera": {
        "zoom": [
          1.0,
          1.1
        ],
        "drift": 0.3
      },
      "transition": "push",
      "say": "A voice agent asks, confirms your answer, and hangs up.",
      "dur": 3.5
    },
    {
      "type": "timeline",
      "title": "Every time a task ends",
      "events": [
        {
          "when": "Task done",
          "what": "Update call"
        },
        {
          "when": "You pick",
          "what": "Next step, by voice"
        },
        {
          "when": "Live",
          "what": "Done, calls again"
        }
      ],
      "camera": {
        "drift": 0.3
      },
      "say": "When a task finishes, it calls with an update and next steps. You pick one, and it does it, live.",
      "dur": 3.5
    },
    {
      "type": "stat",
      "style": "odometer",
      "title": "EVERY MORNING",
      "value": 9,
      "suffix": " AM",
      "size": 300,
      "when": "nine",
      "source": "install.ps1 -Standup 09:00 (configurable)",
      "gradient": [
        "#2A0608",
        "#07070A"
      ],
      "camera": {
        "zoom": [
          1.0,
          1.15
        ]
      },
      "transition": "zoom",
      "say": "Every morning at nine: a standup call about yesterday, and what's next.",
      "dur": 3.5
    },
    {
      "type": "note",
      "invert": true,
      "kicker": "YOUR KEYS STAY YOURS",
      "text": "Keys live in env vars. Never in chat.",
      "small": "Calls run on your own Bolna account.",
      "camera": {
        "zoom": [
          1.1,
          1.0
        ]
      },
      "transition": "wipe",
      "say": "Your keys never touch the chat.",
      "dur": 3.5
    },
    {
